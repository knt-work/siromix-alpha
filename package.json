{
  "name": "siromix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "effect": "3.20.0",
      "fast-xml-parser": "5.5.6",
      "multer": "2.2.0",
      "path-to-regexp": "8.4.0",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "tar": "7.5.19"
    }
  },
  "scripts": {
    "bootstrap": "node scripts/foundation.mjs bootstrap",
    "dev": "node scripts/foundation.mjs dev",
    "stop": "node scripts/foundation.mjs stop",
    "health": "node scripts/foundation.mjs health",
    "doctor": "node scripts/foundation.mjs doctor",
    "db:generate": "pnpm --filter @siromix/database prisma:generate",
    "db:migrate": "pnpm --filter @siromix/database prisma:migrate",
    "db:validate": "pnpm --filter @siromix/database prisma:validate",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:integration": "node scripts/require-integration-profile.mjs && tsx --test --test-concurrency=1 tests/integration/*.test.mjs tests/integration/*.test.ts",
    "test:integration:optional": "tsx --test --test-concurrency=1 tests/integration/*.test.mjs tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:frontend": "jest --config jest.config.mjs --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc -b",
    "build": "pnpm -r build",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "reset:test": "node scripts/foundation.mjs reset-test",
    "readiness": "node scripts/foundation.mjs readiness",
    "performance": "node scripts/foundation.mjs performance",
    "security:scan": "node scripts/security-scan.mjs",
    "artifacts": "node scripts/artifacts.mjs",
    "artifacts:metadata": "node scripts/artifacts.mjs --metadata-only",
    "deployment:verify": "node scripts/deployment.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "jest": "30.1.2",
    "jest-environment-jsdom": "30.1.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  }
}
