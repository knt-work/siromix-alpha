SIROMIX_ENV=local
CONFIG_VERSION=1
DATABASE_URL=postgresql://siromix_app:local-only-password@localhost:5432/siromix
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=siromix-private
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
# Secret values are intentionally omitted. Supply JWT_PRIVATE_KEY,
# JWT_PUBLIC_KEYS_JSON, REFRESH_TOKEN_PEPPER and STORAGE_SECRET_KEY externally.
